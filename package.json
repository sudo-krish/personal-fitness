{
  "name": "personal-fitness-tracker",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages:dev": "npm run build && wrangler pages dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitness-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitness-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4"
  }
}
