# ==============================================================================
# .gitignore — Personal Fitness Tracker (NO-OVERRIDE)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
out/
lib/
*.local

# Cloudflare Wrangler state & logs
.wrangler/
.mf/

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# Cache & Build Info
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Local SQLite databases & cache
*.db
*.db-journal
*.db-wal
*.db-shm
fitness.db
fitness.db.json

# Environment & Secrets
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor Files
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Agent scratch & temporary files
.agent/
.system_generated/
*.tmp
*.temp
tmp/


# Backend API scratch files (Cloudflare Pages Functions in functions/ are used)
server/
